<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javafx.CalculatorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <TextField fx:id="display" prefHeight="60.0" prefWidth="218.0" maxWidth="218.0" editable="false" alignment="CENTER_RIGHT" style="-fx-font-size: 20px;"/>
    <GridPane hgap="5.0" vgap="5.0" alignment="CENTER">
        <Button prefHeight="50.0" prefWidth="50.0" text="C" GridPane.columnIndex="3" GridPane.rowIndex="0" onAction="#handleClear"/>

        <Button prefHeight="50.0" prefWidth="50.0" text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="9" GridPane.columnIndex="2" GridPane.rowIndex="1" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="7" GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="/" GridPane.columnIndex="3" GridPane.rowIndex="1" onAction="#handleOperation"/>

        <Button prefHeight="50.0" prefWidth="50.0" text="4" GridPane.columnIndex="0" GridPane.rowIndex="2" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="5" GridPane.columnIndex="1" GridPane.rowIndex="2" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="6" GridPane.columnIndex="2" GridPane.rowIndex="2" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="*" GridPane.columnIndex="3" GridPane.rowIndex="2" onAction="#handleOperation"/>

        <Button prefHeight="50.0" prefWidth="50.0" text="1" GridPane.columnIndex="0" GridPane.rowIndex="3" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="2" GridPane.columnIndex="1" GridPane.rowIndex="3" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="3" GridPane.columnIndex="2" GridPane.rowIndex="3" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="-" GridPane.columnIndex="3" GridPane.rowIndex="3" onAction="#handleOperation"/>

        <Button prefHeight="50.0" prefWidth="50.0" text="0" GridPane.columnIndex="0" GridPane.rowIndex="4" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="." GridPane.columnIndex="1" GridPane.rowIndex="4" onAction="#handleDigit"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="=" GridPane.columnIndex="2" GridPane.rowIndex="4" onAction="#handleEquals"/>
        <Button prefHeight="50.0" prefWidth="50.0" text="+" GridPane.columnIndex="3" GridPane.rowIndex="4" onAction="#handleOperation"/>

    </GridPane>
</VBox>
